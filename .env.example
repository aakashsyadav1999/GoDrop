# Copy to .env for local development. Real environment variables take priority,
# and command-line flags override both.
GODROP_ADDR=:8080
GODROP_WORKERS=5
GODROP_QUEUE=100
GODROP_JOB_TIMEOUT=10s
# GODROP_REDIS_ADDR=127.0.0.1:6380
GODROP_JOB_TTL=24h
GODROP_SHUTDOWN_TIMEOUT=10s
GODROP_DRAIN_TIMEOUT=30s
GODROP_POSTGRES_DSN=postgres://godrop:godrop@127.0.0.1:5433/godrop?sslmode=disable
